<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>GomezTruckS'tylo | Comunidad de Camiones</title>
<style>
*{box-sizing:border-box}body{margin:0;background:#08090d;color:#fff;font-family:Arial,sans-serif}
header{position:sticky;top:0;z-index:10;background:#0d0e14ee;backdrop-filter:blur(10px);border-bottom:1px solid #272333}
nav{max-width:1200px;margin:auto;display:flex;align-items:center;gap:22px;padding:14px 20px}
.logo{font-size:25px;font-weight:900;font-style:italic}.logo span{color:#a43cff}
nav a{color:#ddd;text-decoration:none;font-size:14px;cursor:pointer}nav a:hover{color:#b14cff}
.btn{background:#8d2cff;color:white;border:0;border-radius:10px;padding:11px 17px;font-weight:bold;cursor:pointer}
.hero{min-height:510px;padding:80px max(7%,20px);display:flex;align-items:center;background:linear-gradient(90deg,#08090df5,#08090d70),url('https://images.unsplash.com/photo-1519003722824-194d4455a60c?auto=format&fit=crop&w=1800&q=80') center/cover}
.hero h1{font-size:clamp(42px,7vw,82px);margin:8px 0}.hero h1 span{color:#a83cff}.hero p{font-size:20px;color:#ddd;max-width:600px}
.container{max-width:1200px;margin:auto;padding:35px 20px}.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:15px}.card{background:#11131b;border:1px solid #282333;border-radius:14px;padding:20px}.stat b{font-size:27px;color:#a83cff}
.section-title{display:flex;justify-content:space-between;align-items:center;margin:35px 0 18px}.section-title h2{margin:0}
.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.photo{height:190px;border-radius:12px;overflow:hidden}.photo img{width:100%;height:100%;object-fit:cover}
.card h3{margin:12px 0 6px}.muted{color:#999;font-size:14px}.price{color:#bd5cff;font-weight:bold;font-size:18px}
input{width:100%;background:#151722;border:1px solid #332b40;color:#fff;border-radius:10px;padding:13px;margin-bottom:18px}
footer{margin-top:40px;border-top:1px solid #282333;padding:35px 20px;text-align:center;color:#999}
.modal{display:none;position:fixed;inset:0;background:#000b;z-index:20;align-items:center;justify-content:center}.modalbox{background:#12141c;border:1px solid #423153;border-radius:16px;padding:25px;max-width:420px;width:90%}
@media(max-width:800px){nav{gap:12px;overflow:auto}nav a{white-space:nowrap}.stats{grid-template-columns:repeat(2,1fr)}.grid{grid-template-columns:1fr 1fr}.hero{min-height:430px}}
@media(max-width:520px){.grid{grid-template-columns:1fr}.hero{padding-top:50px}.hero h1{font-size:46px}.stats{grid-template-columns:1fr 1fr}.logo{font-size:19px}}
</style>
</head>
<body>
<header><nav>
<div class="logo">GomezTruck<span>S'tylo</span></div>
<a href="#inicio">Inicio</a><a href="#camiones">Camiones</a><a href="#videos">Videos</a><a href="#galeria">Galería</a><a href="#eventos">Eventos</a><a href="#tienda">Tienda</a><button class="btn" onclick="openModal()">Registrarse</button>
</nav></header>

<section class="hero" id="inicio"><div>
<div class="muted">PASIÓN POR LOS CAMIONES</div>
<h1>GomezTruck<span>S'tylo</span></h1>
<p>Más que camiones, somos una comunidad. Comparte tus máquinas, videos, fotografías y vive los mejores eventos del mundo camionero.</p>
<button class="btn" onclick="document.querySelector('#videos').scrollIntoView({behavior:'smooth'})">▶ Ver videos</button>
</div></section>

<main class="container">
<div class="stats">
<div class="card stat"><b>+500</b><br><span class="muted">Fotos</span></div>
<div class="card stat"><b>+200</b><br><span class="muted">Videos</span></div>
<div class="card stat"><b>+1.2K</b><br><span class="muted">Miembros</span></div>
<div class="card stat"><b>+15</b><br><span class="muted">Eventos</span></div>
</div>

<section id="camiones"><div class="section-title"><h2>🚛 Camiones destacados</h2><button class="btn" onclick="openPostModal()">+ Publicar camión</button></div>
<input id="search" oninput="filterCards()" placeholder="🔎 Buscar camión, modelo o estilo...">
<div class="grid" id="truckGrid">
<div class="card truck"><div class="photo"><img src="https://images.unsplash.com/photo-1586191582151-f73872dfd183?auto=format&fit=crop&w=800&q=80"></div><h3>Kenworth T800</h3><p class="muted">Potencia en cada kilómetro</p></div>
<div class="card truck"><div class="photo"><img src="https://images.unsplash.com/photo-1616432043562-3671ea2e5242?auto=format&fit=crop&w=800&q=80"></div><h3>Freightliner</h3><p class="muted">Estilo y carretera</p></div>
<div class="card truck"><div class="photo"><img src="https://images.unsplash.com/photo-1601584115197-04ecc0da31d6?auto=format&fit=crop&w=800&q=80"></div><h3>Peterbilt</h3><p class="muted">La pasión del camionero</p></div>
</div></section>

<section id="videos"><div class="section-title"><h2>🎥 Últimos videos</h2></div>
<div class="grid">
<div class="card"><div class="photo"><img src="https://images.unsplash.com/photo-1519003722824-194d4455a60c?auto=format&fit=crop&w=800&q=80"></div><h3>Show de luces</h3><p class="muted">GomezTruckS'tylo · 4:20</p><button class="btn" onclick="alert('Reproductor de video próximamente')">▶ Reproducir</button></div>
<div class="card"><div class="photo"><img src="https://images.unsplash.com/photo-1566576912321-d58ddd7a6088?auto=format&fit=crop&w=800&q=80"></div><h3>Ruta y carretera</h3><p class="muted">La vida del camionero</p><button class="btn" onclick="alert('Reproductor de video próximamente')">▶ Reproducir</button></div>
<div class="card"><div class="photo"><img src="https://images.unsplash.com/photo-1533049673857-9c9f6d0d5f07?auto=format&fit=crop&w=800&q=80"></div><h3>Máquinas de Colombia</h3><p class="muted">Comunidad camionera</p><button class="btn" onclick="alert('Reproductor de video próximamente')">▶ Reproducir</button></div>
</div></section>

<section id="galeria"><div class="section-title"><h2>📸 Galería</h2></div>
<div class="grid">
<div class="photo"><img src="https://images.unsplash.com/photo-1601584115197-04ecc0da31d6?auto=format&fit=crop&w=800&q=80"></div>
<div class="photo"><img src="https://images.unsplash.com/photo-1586191582151-f73872dfd183?auto=format&fit=crop&w=800&q=80"></div>
<div class="photo"><img src="https://images.unsplash.com/photo-1519003722824-194d4455a60c?auto=format&fit=crop&w=800&q=80"></div>
</div></section>

<section id="eventos"><div class="section-title"><h2>🏆 Próximos eventos</h2></div>
<div class="card"><h3>ChecuaStyles 2026</h3><p>📅 9 de agosto de 2026</p><p>📍 Checua, Nemocón – Cundinamarca</p><p class="muted">Encuentro, exhibición, bendición de vehículos, fotografías y premiación.</p><button class="btn" onclick="alert('Detalles del evento')">Ver detalles</button></div></section>

<section id="tienda"><div class="section-title"><h2>🛍️ Tienda</h2></div>
<div class="grid">
<div class="card"><h3>Buso GomezTruckS'tylo</h3><p class="price">$80.000</p><button class="btn" onclick="alert('Producto agregado al carrito')">Comprar</button></div>
<div class="card"><h3>Llavero personalizado</h3><p class="price">$11.000</p><button class="btn" onclick="alert('Producto agregado al carrito')">Comprar</button></div>
<div class="card"><h3>Sticker GomezTruckS'tylo</h3><p class="price">$5.000</p><button class="btn" onclick="alert('Producto agregado al carrito')">Comprar</button></div>
</div></section>
</main>

<footer>GomezTruckS'tylo · La carretera nos une 🚛🔥<br><small>© 2026 GomezTruckS'tylo</small></footer>

<div class="modal" id="modal"><div class="modalbox"><h2>Crear cuenta</h2>
<input id="regName" placeholder="Nombre"><input id="regEmail" placeholder="Correo electrónico"><input id="regPass" type="password" placeholder="Contraseña">
<button class="btn" onclick="register()">Crear cuenta</button> <button onclick="closeModal()">Cerrar</button></div></div>

<div class="modal" id="postModal"><div class="modalbox"><h2>Publicar mi camión</h2>
<input id="truckName" placeholder="Nombre o modelo del camión">
<input id="truckDesc" placeholder="Descripción / estilo">
<input id="truckImg" placeholder="URL de una foto (opcional)">
<button class="btn" onclick="addTruck()">Publicar</button> <button onclick="closePostModal()">Cerrar</button></div></div>
<script>
const KEY='gomeztruckstylo_trucks';
function openModal(){document.getElementById('modal').style.display='flex'}
function closeModal(){document.getElementById('modal').style.display='none'}
function openPostModal(){document.getElementById('postModal').style.display='flex'}
function closePostModal(){document.getElementById('postModal').style.display='none'}
function register(){
 const name=document.getElementById('regName').value.trim();
 const email=document.getElementById('regEmail').value.trim();
 if(!name||!email){alert('Completa nombre y correo.');return}
 localStorage.setItem('gomez_user',JSON.stringify({name,email}));
 closeModal(); alert('¡Bienvenido a GomezTruckS’tylo, '+name+'! Tu perfil fue creado en este dispositivo.');
}
function addTruck(){
 const name=document.getElementById('truckName').value.trim();
 const desc=document.getElementById('truckDesc').value.trim();
 const img=document.getElementById('truckImg').value.trim() || 'https://images.unsplash.com/photo-1519003722824-194d4455a60c?auto=format&fit=crop&w=800&q=80';
 if(!name){alert('Escribe el nombre o modelo del camión.');return}
 const trucks=JSON.parse(localStorage.getItem(KEY)||'[]');
 trucks.push({name,desc,img});
 localStorage.setItem(KEY,JSON.stringify(trucks));
 renderUserTrucks(); closePostModal();
 document.getElementById('truckName').value='';document.getElementById('truckDesc').value='';document.getElementById('truckImg').value='';
}
function renderUserTrucks(){
 const trucks=JSON.parse(localStorage.getItem(KEY)||'[]');
 const grid=document.getElementById('truckGrid');
 trucks.forEach(t=>{
  if(document.querySelector('[data-user-truck="'+CSS.escape(t.name)+'"]')) return;
  const c=document.createElement('div'); c.className='card truck'; c.dataset.userTruck=t.name;
  c.innerHTML='<div class="photo"><img src="'+t.img+'" onerror="this.src=\'https://images.unsplash.com/photo-1519003722824-194d4455a60c?auto=format&fit=crop&w=800&q=80\'"></div><h3>'+escapeHtml(t.name)+'</h3><p class="muted">'+escapeHtml(t.desc||'Publicado por la comunidad')+'</p><button class="btn" onclick="likeTruck(this)">♡ Me gusta</button>';
  grid.appendChild(c);
 })
}
function likeTruck(btn){btn.textContent=btn.textContent.includes('♡')?'♥ Me gusta':'♡ Me gusta'}
function escapeHtml(x){return x.replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[m]))}
function filterCards(){let q=document.getElementById('search').value.toLowerCase();document.querySelectorAll('.truck').forEach(c=>c.style.display=c.innerText.toLowerCase().includes(q)?'block':'none')}
renderUserTrucks();
</script>
</body></html>
